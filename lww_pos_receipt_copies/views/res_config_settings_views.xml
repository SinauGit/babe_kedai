<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_lww_receipt_copies" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lww.pos.receipt.copies</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_iface_print_auto']/ancestor::setting[1]" position="after">
                <setting id="lww_receipt_copies" string="Jumlah Salinan Struk" help="Jumlah salinan struk pelanggan yang dicetak setiap kali struk dicetak.">
                    <field name="pos_receipt_copies"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
